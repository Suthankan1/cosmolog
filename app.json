{
  "expo": {
    "name": "COSMOLOG",
    "slug": "cosmolog",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/brand/launcher-icon.png",
    "scheme": "cosmolog",
    "userInterfaceStyle": "light",
    "ios": {
      "buildNumber": "6",
      "supportsTablet": false,
      "bundleIdentifier": "com.cosmolog.app"
    },
    "android": {
      "versionCode": 6,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.ACTIVITY_RECOGNITION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#184235"
      },
      "package": "com.cosmolog.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/cosmolog-mark-ivory.png",
          "imageWidth": 128,
          "backgroundColor": "#102F26"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow COSMOLOG to use your location to calculate the sky overhead.",
          "locationAlwaysPermission": false,
          "locationAlwaysAndWhenInUsePermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": "Allow COSMOLOG to use phone motion to orient the sky chart."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Allow COSMOLOG to use phone motion to orient the sky chart."
        }
      ],
      "expo-sqlite",
      "expo-image",
      "expo-asset",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow COSMOLOG to access your microphone for voice search and field note dictation.",
          "speechRecognitionPermission": "Allow COSMOLOG to safely convert your speech to text for observation records."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
