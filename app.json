{
  "expo": {
    "name": "COSMOLOG",
    "slug": "cosmolog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/launcher-icon.png",
    "scheme": "cosmolog",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cosmolog.app"
    },
    "android": {
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/cosmolog-mark.png",
        "backgroundColor": "#184235"
      },
      "package": "com.cosmolog.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/cosmolog-mark-ivory.png",
          "imageWidth": 128,
          "backgroundColor": "#102F26"
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      "expo-image",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
